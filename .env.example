# =============================================================
# Pipeline RAG - Variaveis de Ambiente
# Copie este arquivo para .env e preencha com seus valores reais.
# NUNCA commite o .env no git.
#
# Este arquivo contem APENAS credenciais — sao compartilhadas
# entre todos os projetos. O nome da collection e outros
# parametros por projeto ficam no config.yaml.
# =============================================================

# --- OpenRouter ---
# Chave gerada em: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- OpenAI direta ---
OPENAI_API_KEY=sk-...

# --- ChromaDB (se VECTOR_STORE=chroma) ---
CHROMA_PERSIST_DIR=./output/chroma_db

# --- Qdrant (se VECTOR_STORE=qdrant) ---
# Apenas credenciais de acesso — collection_name fica no config.yaml
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# --- Pinecone (se VECTOR_STORE=pinecone) ---
PINECONE_API_KEY=
# O indice e o namespace ficam em vector_store no config.yaml.

# --- Logging ---
LOG_LEVEL=INFO

# --- Backend de aplicacao: conexoes de ingestao (SPEC-0026) ---
# Chave Fernet que cifra as chaves das conexoes cadastradas pela interface.
# Gere com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Em producao (Docker Swarm), aponte APP_CONEXOES_CHAVE_FILE para o secret.
# Trocar a chave exige recadastrar as chaves das conexoes. Nunca versione.
APP_CONEXOES_CHAVE=
# APP_CONEXOES_CHAVE_FILE=/run/secrets/conexoes_chave
# Somente desenvolvimento: aceita URLs de loopback (ex.: Qdrant em localhost) nas conexoes.
# APP_CONEXOES_PERMITIR_HOSTS_LOCAIS=true
