# Frontend demonstrável (SPEC-0013) — variáveis de ambiente
# Copie para .env.local e ajuste. Este arquivo não contém segredos.

# Destino do proxy `/api/*` configurado em next.config.ts. O navegador nunca
# fala com este endereço: o Next reencaminha no servidor, mantendo tudo em
# mesma origem (sem CORS e compatível com a CSP, que não declara connect-src).
# Padrão quando ausente: http://127.0.0.1:8000
API_PROXY_TARGET=http://127.0.0.1:8000

# Prefixo aplicado às chamadas do api-client. Deixe VAZIO para usar o proxy
# acima (URL relativa, mesma origem). Só preencha para apontar o navegador
# direto a outra origem — o que exigiria CORS no backend e `connect-src` na CSP.
NEXT_PUBLIC_API_BASE_URL=
