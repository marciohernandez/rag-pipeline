# Variáveis do deploy em Compose (SPEC-0045): só os NOMES; os valores ficam no `.env` do
# servidor (permissão 600), criado pela pessoa responsável, que nunca vai para o Git.
# Os segredos (chaves e senhas) não ficam aqui: são arquivos de permissão 600 na pasta
# apontada por SEGREDOS_DIR (ver deploy/RUNBOOK_COMPOSE.md).

# Obrigatórias: o Compose recusa subir sem elas.
DOMINIO_RAGPIPELINE=
QDRANT_URL=
SEGREDOS_DIR=

# Prefixo das coleções do sistema no Qdrant publicado (por exemplo, beta-).
APP_COLECAO_PREFIXO=

# Opcionais, com padrão no compose.yml.
APP_EMBEDDING_PROVIDER=
APP_LLM_PROVIDER=
LLM_MODEL=
APP_ASSISTANT_KNOWLEDGE_COLLECTION=
APP_VECTOR_STORE_COLLECTION=
API_PROXY_TARGET=
BACKUP_HORA=
BACKUP_TIMEOUT_SEGUNDOS=
BACKUP_MIN_BYTES=
BACKUP_TENTATIVAS=
HSTS_MAX_AGE_SEGUNDOS=
LOGIN_RATE_LIMIT_MEDIA=
LOGIN_RATE_LIMIT_RAJADA=
