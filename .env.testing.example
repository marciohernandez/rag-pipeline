# Credenciais do Postgres de TESTES (Supabase). Copie para .env.testing (ignorado
# pelo git) e preencha. Nunca use aqui o banco de desenvolvimento do .env.
APP_ENV=testing

# Supabase > Project Settings > Database > Connection string > "Session pooler"
# (porta 5432, funciona com migrations). Troque o prefixo por postgresql+psycopg://
# e mantenha sslmode=require. Se a senha tiver @ : / # %, codifique-a (%40, %3A...).
#   [REF]      referência do projeto (ex.: abcdefghijklmnop)
#   [REGION]   região do pooler (ex.: sa-east-1)
#   [PASSWORD] senha do banco
APP_DATABASE_URL=postgresql+psycopg://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require

# Qdrant publicado. A chave continua em QDRANT_API_KEY no .env.
QDRANT_URL=https://qdrant.smartsystem.ia.br
